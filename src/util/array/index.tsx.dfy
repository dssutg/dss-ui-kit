// Generated by lsc from index.tsx

function sumFrom(xs: seq<int>, i: nat): int
  decreases (|xs| - i)
{
  if (i >= |xs|) then
    0
  else
    ((if ((0 <= i) && (i < |xs|)) then xs[i] else 0) + sumFrom(xs, (i + 1)))
}

method sumArray(array_: seq<int>) returns (res: int)
  ensures (res == sumFrom(array_, 0))
{
  var sum := 0;
  var i := 0;
  while (i < |array_|)
    invariant (0 <= i)
    invariant (i <= |array_|)
    invariant ((sum + sumFrom(array_, i)) == sumFrom(array_, 0))
    decreases (|array_| - i)
  {
    sum := (sum + (if ((0 <= i) && (i < |array_|)) then array_[i] else 0));
    i := (i + 1);
  }
  return sum;
}
