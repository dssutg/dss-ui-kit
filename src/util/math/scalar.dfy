// Generated by lsc from scalar.ts

function JSRem(a: int, b: int): int
  requires b != 0
{
  var r := (if a < 0 then -a else a) % (if b < 0 then -b else b);
  if a < 0 then -r else r
}

function MathMin(a: int, b: int): int { if a <= b then a else b }

function MathMax(a: int, b: int): int { if a >= b then a else b }

function clamp(value: int, min: int, max: int): int
  requires (min <= max)
{
  MathMax(min, MathMin(max, value))
}

lemma clamp_ensures(value: int, min: int, max: int)
  requires (min <= max)
  ensures (clamp(value, min, max) >= min)
  ensures (clamp(value, min, max) <= max)
  ensures ((value < min) ==> (clamp(value, min, max) == min))
  ensures ((value > max) ==> (clamp(value, min, max) == max))
{
}

function lerp(min: int, max: int, progress: int): int
{
  (((1 - progress) * min) + (progress * max))
}

lemma lerp_ensures(min: int, max: int, progress: int)
  ensures (lerp(min, max, progress) == (((1 - progress) * min) + (progress * max)))
{
}

function modulo(a: int, b: int): int
  requires (b > 0)
{
  JSRem((JSRem(a, b) + b), b)
}

lemma modulo_ensures(a: int, b: int)
  requires (b > 0)
  ensures (modulo(a, b) >= 0)
  ensures (modulo(a, b) < b)
{
}

function wrapIndex(index: int, length: int): int
  requires (length > 0)
{
  if (length == 0) then
    0
  else
    modulo(index, length)
}

lemma wrapIndex_ensures(index: int, length: int)
  requires (length > 0)
  ensures (wrapIndex(index, length) >= 0)
  ensures (wrapIndex(index, length) < length)
{
}

function step(x: int, threshold: int): int
{
  if (x >= threshold) then
    1
  else
    0
}

lemma step_ensures(x: int, threshold: int)
  ensures ((x >= threshold) ==> (step(x, threshold) == 1))
  ensures ((x < threshold) ==> (step(x, threshold) == 0))
{
}

method roundToPowerOfTwo(n: int) returns (res: int)
  ensures ((n <= 0) ==> (res == 0))
  ensures ((n > 0) ==> (res >= n))
  ensures ((n > 0) ==> (res < (2 * n)))
{
  if (n <= 0) {
    return 0;
  }
  var power := 1;
  while (power < n)
    invariant (power >= 1)
    invariant (power < (2 * n))
    decreases ((2 * n) - power)
  {
    power := (power * 2);
  }
  return power;
}
