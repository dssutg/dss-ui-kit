// Generated by lsc from index.tsx

method trimEndNewlines(str: string) returns (res: string)
  ensures (|res| <= |str|)
  ensures (str[0..|res|] == res)
  ensures forall k: int :: ((|res| <= k) ==> (k < |str|) ==> (((str[k] as int) == 10) || ((str[k] as int) == 13)))
  ensures ((|res| == 0) || (((str[(|res| - 1)] as int) != 10) && ((str[(|res| - 1)] as int) != 13)))
{
  var end := |str|;
  while (end > 0)
    invariant (0 <= end)
    invariant (end <= |str|)
    invariant forall k: int :: ((end <= k) ==> (k < |str|) ==> (((str[k] as int) == 10) || ((str[k] as int) == 13)))
    decreases end
  {
    var c := (str[(end - 1)] as int);
    if ((c != 10) && (c != 13)) {
      break;
    }
    end := (end - 1);
  }
  return (if (end == |str|) then str else str[0..end]);
}
