{
  "name": "dss-ui-kit",
  "version": "0.5.1",
  "type": "module",
  "description": "Preact component library and design system: CSS custom-property tokens, an event bus, localisation, and a generic WebGL scene renderer",
  "license": "MIT",
  "keywords": [
    "preact",
    "components",
    "design-system",
    "tailwindcss",
    "ui",
    "dss"
  ],
  "engines": {
    "node": "26.10.0"
  },
  "main": "./dist/dss-ui-kit.umd.cjs",
  "module": "./dist/dss-ui-kit.js",
  "types": "./dist/types/index.d.ts",
  "style": "./dist/dss-ui-kit.css",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/dss-ui-kit.js",
      "require": "./dist/dss-ui-kit.umd.cjs"
    },
    "./style.css": "./dist/dss-ui-kit.css",
    "./tailwind": {
      "types": "./dist/types/tailwind_preset.d.ts",
      "import": "./dist/tailwind.js"
    },
    "./testing": {
      "types": "./dist/types/testing.d.ts",
      "import": "./dist/testing.js"
    },
    "./util": {
      "types": "./dist/types/util/index.d.ts",
      "import": "./dist/util.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "src/css",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "vite",
    "build": "npm run build:bundle && npm run build:preset && npm run build:testing && npm run build:util && npm run build:css && npm run build:types",
    "build:bundle": "vite build",
    "build:preset": "vite build --config vite.preset.config.ts",
    "build:testing": "vite build --config vite.testing.config.ts",
    "build:util": "vite build --config vite.util.config.ts",
    "build:css": "vite build --config vite.css.config.ts",
    "build:types": "tsgo --emitDeclarationOnly --declaration --declarationMap --outDir dist/types -p tsconfig.build.json",
    "pack": "node --experimental-strip-types scripts/check-package-manifest.ts",
    "preview": "vite preview",
    "typecheck": "tsgo --noEmit -p tsconfig.json && tsgo --noEmit -p tsconfig.node.json",
    "lint": "npm run lint:biome && npm run lint:markdown && npm run typecheck",
    "lint:biome": "biome ci .",
    "lint:markdown": "markdownlint-cli2",
    "lint:commits": "bump-version lint",
    "lint:types": "npm run typecheck",
    "format": "biome check --write .",
    "format:check": "biome format .",
    "format:markdown": "markdownlint-cli2 --fix",
    "install:frozen": "npm ci",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "docs": "typedoc",
    "docs:watch": "typedoc --watch",
    "icons": "node --experimental-strip-types scripts/bundle-icons.ts",
    "lemmascript:gen": "lsc gen --backend=dafny",
    "lemmascript:check": "lsc check --backend=dafny",
    "duplication:baseline": "node --experimental-strip-types scripts/update-duplication-baseline.ts",
    "design-tokens:baseline": "node --experimental-strip-types scripts/update-design-token-baseline.ts",
    "type-assertions:baseline": "node --experimental-strip-types scripts/update-type-assertion-baseline.ts",
    "ci": "npm run install:frozen && npm run format:check && npm run lint && npm run lint:commits && npm run test && npm run test:coverage && npm run build && npm run pack && npm run release:dry && npm run docs",
    "prepublishOnly": "npm run build",
    "release": "npm publish",
    "release:dry": "npm publish --dry-run",
    "codemod": "codemod"
  },
  "peerDependencies": {
    "preact": ">=10.19.0 <11"
  },
  "dependencies": {
    "tailwind-merge": "2.6.1"
  },
  "devDependencies": {
    "@ast-grep/cli": "0.45.3",
    "@biomejs/biome": "2.5.14",
    "@preact/preset-vite": "2.10.6",
    "@tailwindcss/forms": "0.5.11",
    "@types/node": "26.6.3",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "@vitest/coverage-v8": "5.0.2",
    "autoprefixer": "10.6.1",
    "codemod": "1.18.3",
    "jsdom": "30.1.1",
    "lemmascript": "0.6.4",
    "markdownlint-cli2": "0.23.3",
    "postcss": "8.5.28",
    "preact": "10.29.8",
    "tailwindcss": "3.4.19",
    "typedoc": "0.28.20",
    "typescript": "6.0.3",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  }
}
